#!/usr/bin/env bash
# Runs the preflight before a push: formatting and lints on all three
# platforms, which is most of what has turned CI red on a release commit.
# See `.github/scripts/preflight.sh`. `FONTELLE_SKIP_PREFLIGHT=1` skips it.
if [ -n "${FONTELLE_SKIP_PREFLIGHT:-}" ]; then
    exit 0
fi
# Deleting a branch or tag pushes nothing to check.
pushes=0
while read -r _ local_sha _ _; do
    [ "$local_sha" != "0000000000000000000000000000000000000000" ] && pushes=1
done
[ "$pushes" = 1 ] || exit 0
exec "$(git rev-parse --show-toplevel)/.github/scripts/preflight.sh"
